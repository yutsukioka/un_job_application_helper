{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasVault signed state commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "collection_id", "sequence", "previous_root", "state_sha256", "root", "signature_b64"],
  "properties": {
    "format": {"const": "atlasvault-state-commitment"},
    "version": {"const": 1},
    "collection_id": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
