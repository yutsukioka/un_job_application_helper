{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasvault.invalid/sync/atlasvault_historical_authority_v1.schema.json",
  "title": "D106 bounded public historical-authority supplement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "anchor_root", "account_id", "vault_id", "registry_root", "key_epoch", "registry_generation", "collection_sha256", "recipient_device_id", "transcript_sha256", "signed_descriptors", "prior_registry", "revocation", "views"],
  "properties": {
    "format": {"const": "atlasvault-historical-authority"},
    "version": {"type": "integer", "const": 1},
    "anchor_root": {"$ref": "#/$defs/hash"},
    "account_id": {"$ref": "#/$defs/id"},
    "vault_id": {"$ref": "#/$defs/id"},
    "registry_root": {"$ref": "#/$defs/hash"},
    "key_epoch": {"$ref": "#/$defs/epoch"},
    "registry_generation": {"$ref": "#/$defs/epoch"},
    "collection_sha256": {"$ref": "#/$defs/hash"},
    "recipient_device_id": {"$ref": "#/$defs/device"},
    "transcript_sha256": {"$ref": "#/$defs/hash"},
    "signed_descriptors": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/signed_descriptor"}},
    "prior_registry": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}},
    "revocation": {"$ref": "device_revocation_v1.schema.json#/$defs/transition"},
    "views": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "authenticated_state_view.schema.json"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.~-]{1,128}$"},
    "device": {"type": "string", "pattern": "^avd1-[0-9a-f]{64}$"},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "public": {"type": "string", "minLength": 44, "maxLength": 44},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88},
    "entry": {"type": "object", "additionalProperties": false, "required": ["device_id", "state", "signing_public_b64", "agreement_public_b64"], "properties": {
      "device_id": {"$ref": "#/$defs/device"}, "state": {"const": "ACTIVE"}, "signing_public_b64": {"$ref": "#/$defs/public"}, "agreement_public_b64": {"$ref": "#/$defs/public"}
    }},
    "signed_descriptor": {"type": "object", "additionalProperties": false, "required": ["format", "version", "descriptor", "signature"], "properties": {
      "format": {"const": "atlasvault-signed-device-descriptor"}, "version": {"type": "integer", "const": 1}, "signature": {"$ref": "#/$defs/signature"},
      "descriptor": {"type": "object", "additionalProperties": false, "required": ["format", "version", "device_id", "signing_public_key", "agreement_public_key", "created_at", "key_epoch"], "properties": {
        "format": {"const": "atlasvault-device-descriptor"}, "version": {"type": "integer", "const": 1}, "device_id": {"$ref": "#/$defs/device"}, "signing_public_key": {"$ref": "#/$defs/public"}, "agreement_public_key": {"$ref": "#/$defs/public"}, "created_at": {"type": "string", "maxLength": 32}, "key_epoch": {"$ref": "#/$defs/epoch"}
      }}
    }}
  }
}
