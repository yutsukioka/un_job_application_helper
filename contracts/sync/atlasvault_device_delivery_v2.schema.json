{
  "$defs": {
    "DeviceDeliveryProof": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "atlasvault-device-delivery-proof",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "const": 2,
          "title": "Version",
          "type": "integer"
        },
        "activation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Activation Id",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/RotationPlan"
        },
        "revocation": {
          "$ref": "#/$defs/RevocationTransition"
        },
        "registry": {
          "items": {
            "$ref": "#/$defs/RegistryEntry"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Registry",
          "type": "array"
        },
        "recipient_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Recipient Device Id",
          "type": "string"
        },
        "recipient_agreement_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Recipient Agreement Sha256",
          "type": "string"
        },
        "wrapper_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Wrapper Sha256",
          "type": "string"
        },
        "registry_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Registry Generation",
          "type": "integer"
        },
        "issuer_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Issuer Device Id",
          "type": "string"
        },
        "rotation_signer_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Rotation Signer Device Id",
          "type": "string"
        },
        "hpke_suite": {
          "const": "0x0020/0x0001/0x0002",
          "title": "Hpke Suite",
          "type": "string"
        },
        "hpke_version": {
          "const": 2,
          "title": "Hpke Version",
          "type": "integer"
        },
        "signature_algorithm": {
          "const": "Ed25519",
          "title": "Signature Algorithm",
          "type": "string"
        },
        "signature_version": {
          "const": 1,
          "title": "Signature Version",
          "type": "integer"
        },
        "root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root",
          "type": "string"
        },
        "signature_b64": {
          "maxLength": 88,
          "minLength": 88,
          "title": "Signature B64",
          "type": "string"
        }
      },
      "required": [
        "format",
        "version",
        "activation_id",
        "plan",
        "revocation",
        "registry",
        "recipient_device_id",
        "recipient_agreement_sha256",
        "wrapper_sha256",
        "registry_generation",
        "issuer_device_id",
        "rotation_signer_device_id",
        "hpke_suite",
        "hpke_version",
        "signature_algorithm",
        "signature_version",
        "root",
        "signature_b64"
      ],
      "title": "DeviceDeliveryProof",
      "type": "object"
    },
    "EpochDelivery": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "key_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Key Epoch",
          "type": "integer"
        },
        "encapsulated_key_b64": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Encapsulated Key B64",
          "type": "string"
        },
        "ciphertext_b64": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Ciphertext B64",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "key_epoch",
        "encapsulated_key_b64",
        "ciphertext_b64"
      ],
      "title": "EpochDelivery",
      "type": "object"
    },
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Device Id",
          "type": "string"
        },
        "signing_public_b64": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Signing Public B64",
          "type": "string"
        },
        "agreement_public_b64": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Agreement Public B64",
          "type": "string"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "signing_public_b64",
        "agreement_public_b64",
        "state"
      ],
      "title": "RegistryEntry",
      "type": "object"
    },
    "RevocationTransition": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "atlasvault-device-revocation",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "account_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Account Id",
          "type": "string"
        },
        "vault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Vault Id",
          "type": "string"
        },
        "target_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Target Device Id",
          "type": "string"
        },
        "initiator_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Initiator Device Id",
          "type": "string"
        },
        "prior_registry_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Registry Root",
          "type": "string"
        },
        "resulting_registry_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resulting Registry Root",
          "type": "string"
        },
        "key_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Key Epoch",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "authorization_category": {
          "const": "DEVICE_PRESENCE",
          "title": "Authorization Category",
          "type": "string"
        },
        "root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root",
          "type": "string"
        },
        "signature_b64": {
          "maxLength": 88,
          "minLength": 88,
          "title": "Signature B64",
          "type": "string"
        }
      },
      "required": [
        "format",
        "version",
        "account_id",
        "vault_id",
        "target_device_id",
        "initiator_device_id",
        "prior_registry_root",
        "resulting_registry_root",
        "key_epoch",
        "sequence",
        "authorization_category",
        "root",
        "signature_b64"
      ],
      "title": "RevocationTransition",
      "type": "object"
    },
    "RotationPlan": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "atlasvault-rotation-plan",
          "title": "Format",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "account_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Account Id",
          "type": "string"
        },
        "vault_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Vault Id",
          "type": "string"
        },
        "previous_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Previous Epoch",
          "type": "integer"
        },
        "new_epoch": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "New Epoch",
          "type": "integer"
        },
        "prior_registry_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Registry Root",
          "type": "string"
        },
        "resulting_registry_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resulting Registry Root",
          "type": "string"
        },
        "state_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Root",
          "type": "string"
        },
        "initiator_device_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "title": "Initiator Device Id",
          "type": "string"
        },
        "revocation_root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revocation Root",
          "type": "string"
        },
        "recipients": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Recipients",
          "type": "array"
        }
      },
      "required": [
        "format",
        "version",
        "account_id",
        "vault_id",
        "previous_epoch",
        "new_epoch",
        "prior_registry_root",
        "resulting_registry_root",
        "state_root",
        "initiator_device_id",
        "revocation_root",
        "recipients"
      ],
      "title": "RotationPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proof": {
      "$ref": "#/$defs/DeviceDeliveryProof"
    },
    "wrapper": {
      "$ref": "#/$defs/EpochDelivery"
    }
  },
  "required": [
    "proof",
    "wrapper"
  ],
  "title": "DeviceDeliveryPacket",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
