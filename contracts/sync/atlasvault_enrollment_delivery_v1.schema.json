{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasVault recipient-bound enrollment delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "hpke_suite", "anchor", "registry", "collection", "opaque_b64", "historical_authority", "deliveries", "root", "signature_b64"],
  "properties": {
    "format": {"const": "atlasvault-enrollment-delivery"},
    "version": {"const": 1, "type": "integer"},
    "hpke_suite": {"const": "0x0020/0x0001/0x0002"},
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint", "enrollment", "view"],
      "properties": {"checkpoint": {"type": "object"}, "enrollment": {"type": "object"}, "view": {"type": "object"}}
    },
    "registry": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}},
    "collection": {"type": "object"},
    "opaque_b64": {"type": "string", "minLength": 1, "maxLength": 1398104},
    "historical_authority": {"type": ["object", "null"]},
    "deliveries": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_epoch", "encapsulated_key_b64", "ciphertext_b64"],
        "properties": {
          "key_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
          "encapsulated_key_b64": {"type": "string", "minLength": 44, "maxLength": 44},
          "ciphertext_b64": {"type": "string", "minLength": 64, "maxLength": 64}
        }
      }
    },
    "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_b64": {"type": "string", "minLength": 88, "maxLength": 88}
  }
}
