{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasVault additive device enrollment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "account_id",
    "vault_id",
    "registry_generation",
    "key_epoch",
    "state_root",
    "activation_id",
    "next_registry_generation",
    "prior_registry_root",
    "resulting_registry_root",
    "target_device_id",
    "target_signing_public_b64",
    "target_agreement_public_b64",
    "target_agreement_sha256",
    "transcript_sha256",
    "issuer_device_id",
    "authorization_category",
    "signature_algorithm",
    "root",
    "signature_b64"
  ],
  "properties": {
    "format": {
      "const": "atlasvault-device-enrollment"
    },
    "version": {
      "const": 1
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.~-]{1,128}$"
    },
    "vault_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.~-]{1,128}$"
    },
    "registry_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "state_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "next_registry_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "prior_registry_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resulting_registry_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_device_id": {
      "type": "string",
      "pattern": "^avd1-[0-9a-f]{64}$"
    },
    "target_signing_public_b64": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "target_agreement_public_b64": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "target_agreement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer_device_id": {
      "type": "string",
      "pattern": "^avd1-[0-9a-f]{64}$"
    },
    "authorization_category": {
      "const": "SAS_CONFIRMED"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
